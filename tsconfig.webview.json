{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  // src/server/dialect.ts is dialect-detection CORE (pure, no host
  // imports) shared with the webview unit tests; everything else under
  // src/server is host-only.
  "include": ["src/webview/app", "src/server/dialect.ts"]
}
